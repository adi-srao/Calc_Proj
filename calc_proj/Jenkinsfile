pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('calc_proj') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('calc_proj') {
                    sh './mvnw test'
                }
            }
            post {
                always {
                    junit 'calc_proj/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('calc_proj') {
                    sh 'docker build -t calculator-api:latest .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('calc_proj') {
                    sh 'docker compose down'
                    sh 'docker compose up -d --build'
                }
            }
        }
    }

    post {
        always {
            sh 'docker image prune -f'
        }
        success {
            mail to: 'adityaraosunil@gmail.com',
                 subject: "Pipeline Success: ${JOB_NAME} [${BUILD_NUMBER}]",
                 body: "The build and deployment succeeded for build ${BUILD_NUMBER}."
        }
        failure {
            mail to: 'adityaraosunil@gmail.com',
                 subject: "Pipeline Failure: ${JOB_NAME} [${BUILD_NUMBER}]",
                 body: "The build failed at build ${BUILD_NUMBER}. Please check Jenkins console output."
        }
    }
}